<%= form_with model: game, local: true, html: { multipart: true, class: "game-form" } do |f| %>
  <% if game.errors.any? %>
    <div class="flash-alert">
      <ul class="error-list">
        <% game.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- 試合基本情報セクション -->
  <fieldset class="form-section">
    <legend class="form-section-title">試合情報</legend>

    <div class="form-field">
      <%= f.label :date, class: "form-label" do %>
        観戦日<span class="label-required">必須</span>
      <% end %>
      <%= f.date_field :date, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :home_away, class: "form-label" do %>
        ホーム / ビジター<span class="label-required">必須</span>
      <% end %>
      <div class="radio-group">
        <label class="radio-option">
          <%= f.radio_button :home_away, :home, class: "radio-input" %>
          <span class="radio-label">ホーム</span>
        </label>
        <label class="radio-option">
          <%= f.radio_button :home_away, :away, class: "radio-input" %>
          <span class="radio-label">ビジター</span>
        </label>
      </div>
    </div>

    <div class="form-field">
      <%= f.label :opponent_team_id, class: "form-label" do %>
        対戦相手<span class="label-required">必須</span>
      <% end %>
      <%= f.collection_select :opponent_team_id, teams, :id, :name, { prompt: "選択してください" }, { class: "form-select", id: "game_opponent_team_id" } %>
    </div>

    <div class="form-field">
      <%= f.label :stadium_id, class: "form-label" do %>
        球場<span class="label-required">必須</span>
      <% end %>
      <%= f.collection_select :stadium_id, stadiums, :id, :name, { prompt: "選択してください" }, { class: "form-select", id: "game_stadium_id" } %>
    </div>

    <div class="form-field" id="custom_stadium_field" style="display:none;">
      <%= f.label :custom_stadium_name, class: "form-label" do %>
        球場名<span class="label-required">その他の場合は必須</span>
      <% end %>
      <%= f.text_field :custom_stadium_name, placeholder: "例：○○グラウンド", class: "form-input" %>
    </div>
  </fieldset>

  <!-- スコアセクション -->
  <fieldset class="form-section">
    <legend class="form-section-title">スコア</legend>

    <div class="score-row">
      <div class="score-field">
        <%= f.label :favorite_team_score, class: "form-label" do %>
          <%= current_user.favorite_team.display_name(:short) %><span class="label-required">必須</span>
        <% end %>
        <%= f.number_field :favorite_team_score, min: 0, class: "form-input score-input" %>
      </div>
      <div class="score-separator">
        <span class="score-vs">-</span>
      </div>
      <div class="score-field">
        <%= f.label :opponent_score, class: "form-label" do %>
          <span id="opponent-score-label">相手</span><span class="label-required">必須</span>
        <% end %>
        <%= f.number_field :opponent_score, min: 0, class: "form-input score-input" %>
      </div>
    </div>
  </fieldset>

  <!-- 詳細情報セクション -->
  <fieldset class="form-section">
    <legend class="form-section-title">詳細（任意）</legend>

    <div class="form-field">
      <%= f.label :starting_pitcher, class: "form-label" do %>
        先発投手
      <% end %>
      <%= f.text_field :starting_pitcher, class: "form-input", placeholder: "例：伊藤大海" %>
    </div>

    <div class="form-field">
      <%= f.label :photos, class: "form-label" do %>
        写真（複数可）
      <% end %>
      <div class="file-upload-area" id="photo-upload-area">
        <input type="file" multiple accept="image/*" class="file-input" id="photo-picker">
        <div class="file-upload-hint" id="photo-upload-hint">クリックまたはドラッグして画像を選択</div>
      </div>
      <div class="photo-preview-grid" id="photo-preview-grid"></div>
      <!-- 実際に送信されるfile input（JSで管理） -->
      <div id="photo-hidden-inputs"></div>
    </div>

    <div class="form-field">
      <%= f.label :video_url, class: "form-label" do %>
        動画リンク
      <% end %>
      <%= f.url_field :video_url, placeholder: "https://...", class: "form-input" %>
    </div>
  </fieldset>

  <!-- 送信ボタン -->
  <div class="form-actions">
    <%= f.submit "登録する", class: "btn-submit" %>
    <%= link_to "キャンセル", dashboard_path, class: "btn-cancel" %>
  </div>
<% end %>

<script>
  function initGameForm() {
    // 球場「その他」トグル
    const stadiumSelect = document.getElementById("game_stadium_id");
    const customField = document.getElementById("custom_stadium_field");
    if (stadiumSelect && customField) {
      const OTHER_NAME = "その他";
      const toggleStadium = () => {
        const selectedText = stadiumSelect.options[stadiumSelect.selectedIndex]?.text;
        customField.style.display = (selectedText === OTHER_NAME) ? "block" : "none";
      };
      toggleStadium();
      stadiumSelect.addEventListener("change", toggleStadium);
    }

    // 写真プレビュー・削除管理
    const photoPicker = document.getElementById("photo-picker");
    const previewGrid = document.getElementById("photo-preview-grid");
    const uploadHint = document.getElementById("photo-upload-hint");
    const hiddenInputs = document.getElementById("photo-hidden-inputs");
    let selectedFiles = [];

    function renderPreviews() {
      if (!previewGrid || !hiddenInputs) return;
      previewGrid.innerHTML = "";
      hiddenInputs.innerHTML = "";

      if (uploadHint) {
        uploadHint.textContent = selectedFiles.length > 0
          ? selectedFiles.length + "枚の画像を選択中"
          : "クリックまたはドラッグして画像を選択";
      }

      selectedFiles.forEach((file, index) => {
        // hidden file input生成（DataTransferで1ファイルずつ）
        const dt = new DataTransfer();
        dt.items.add(file);
        const hiddenInput = document.createElement("input");
        hiddenInput.type = "file";
        hiddenInput.name = "game[photos][]";
        hiddenInput.files = dt.files;
        hiddenInput.style.display = "none";
        hiddenInputs.appendChild(hiddenInput);

        // プレビューカード生成
        const reader = new FileReader();
        reader.onload = (e) => {
          const item = document.createElement("div");
          item.className = "photo-preview-item";
          item.innerHTML =
            '<div class="photo-preview-img-wrap">' +
              '<img src="' + e.target.result + '" alt="プレビュー ' + (index + 1) + '" class="photo-preview-img">' +
              '<button type="button" class="photo-remove-btn" data-index="' + index + '" title="削除">&#10005;</button>' +
            '</div>' +
            '<span class="photo-preview-name">' + file.name + '</span>';
          previewGrid.appendChild(item);

          item.querySelector(".photo-remove-btn").addEventListener("click", (ev) => {
            ev.preventDefault();
            selectedFiles.splice(index, 1);
            renderPreviews();
          });
        };
        reader.readAsDataURL(file);
      });
    }

    if (photoPicker) {
      photoPicker.addEventListener("change", () => {
        Array.from(photoPicker.files).forEach((file) => {
          if (file.type.startsWith("image/")) {
            selectedFiles.push(file);
          }
        });
        photoPicker.value = "";
        renderPreviews();
      });
    }
    const teamShortNames = <%= raw teams.map { |t| [t.id, t.short_name] }.to_h.to_json %>;
    const opponentSelect = document.getElementById("game_opponent_team_id");
    const opponentLabel = document.getElementById("opponent-score-label");
    if (opponentSelect && opponentLabel) {
      const updateLabel = () => {
        const teamId = parseInt(opponentSelect.value);
        opponentLabel.textContent = teamShortNames[teamId] || "相手";
      };
      updateLabel();
      opponentSelect.addEventListener("change", updateLabel);
    }
  }

  document.addEventListener("turbo:load", initGameForm);
  document.addEventListener("DOMContentLoaded", initGameForm);
</script>
