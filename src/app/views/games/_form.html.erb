<%= form_with model: game, local: true, html: { multipart: true, class: "game-form" } do |f| %>
  <% if game.errors.any? %>
    <div class="flash-alert">
      <ul class="error-list">
        <% [
          :date,
          :home_away,
          :opponent_team_id,
          :stadium_id,
          :favorite_team_score,
          :opponent_score
        ].each do |attr| %>
          <% game.errors.full_messages_for(attr).each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- 試合基本情報セクション -->
  <fieldset class="form-section">
    <legend class="form-section-title">試合情報</legend>

    <div class="form-field">
      <%= f.label :date, class: "form-label" do %>
        観戦日<span class="label-required">必須</span>
      <% end %>
      <%= f.date_field :date, class: "form-input" %>
    </div>

    <div class="form-field">
      <%= f.label :home_away, class: "form-label" do %>
        ホーム / ビジター<span class="label-required">必須</span>
      <% end %>
      <div class="radio-group">
        <label class="radio-option">
          <%= f.radio_button :home_away, :home, class: "radio-input" %>
          <span class="radio-label">ホーム</span>
        </label>
        <label class="radio-option">
          <%= f.radio_button :home_away, :away, class: "radio-input" %>
          <span class="radio-label">ビジター</span>
        </label>
      </div>
    </div>

    <div class="form-field">
      <%= f.label :opponent_team_id, class: "form-label" do %>
        対戦相手<span class="label-required">必須</span>
      <% end %>
      <%= f.select :opponent_team_id,
          teams.map { |t| [t.name, t.id, { "data-short-name" => t.short_name }] },
          { prompt: "選択してください" },
          { class: "form-select", id: "game_opponent_team_id" } %>
    </div>

    <div class="form-field">
      <%= f.label :stadium_id, class: "form-label" do %>
        球場<span class="label-required">必須</span>
      <% end %>
      <%= f.collection_select :stadium_id, stadiums, :id, :name, { prompt: "選択してください" }, { class: "form-select", id: "game_stadium_id" } %>
    </div>

    <div class="form-field" id="custom_stadium_field" style="display:none;">
      <%= f.label :custom_stadium_name, class: "form-label" do %>
        球場名<span class="label-required">その他の場合は必須</span>
      <% end %>
      <%= f.text_field :custom_stadium_name, placeholder: "例：○○グラウンド", class: "form-input" %>
    </div>
  </fieldset>

  <!-- スコアセクション -->
  <fieldset class="form-section">
    <legend class="form-section-title">スコア</legend>

    <div class="score-row">
      <div class="score-field">
        <%= f.label :favorite_team_score, class: "form-label" do %>
          <%= current_user.favorite_team.display_name(:short) %><span class="label-required">必須</span>
        <% end %>
        <%= f.number_field :favorite_team_score, min: 0, class: "form-input score-input" %>
      </div>
      <div class="score-separator">
        <span class="score-vs">-</span>
      </div>
      <div class="score-field">
        <%= f.label :opponent_score, class: "form-label" do %>
          <span id="opponent-score-label">相手</span><span class="label-required">必須</span>
        <% end %>
        <%= f.number_field :opponent_score, min: 0, class: "form-input score-input" %>
      </div>
    </div>
  </fieldset>

  <!-- 詳細情報セクション -->
  <fieldset class="form-section">
    <legend class="form-section-title">詳細（任意）</legend>

    <div class="form-field">
      <%= f.label :starting_pitcher, class: "form-label" do %>
        先発投手
      <% end %>
      <%= f.text_field :starting_pitcher, class: "form-input", placeholder: "例：伊藤大海" %>
    </div>

    <div class="form-field">
      <%= f.label :photos, class: "form-label" do %>
        写真（複数可）
      <% end %>
      <div class="file-upload-area" id="photo-upload-area">
        <input type="file" multiple accept="image/*" class="file-input" id="photo-picker">
        <div class="file-upload-hint" id="photo-upload-hint">クリックまたはドラッグして画像を選択</div>
      </div>
      <div class="photo-preview-grid" id="photo-preview-grid"></div>
      <div id="photo-hidden-inputs"></div>
    </div>

    <div class="form-field">
      <%= f.label :video_url, class: "form-label" do %>
        動画リンク
      <% end %>
      <%= f.url_field :video_url, placeholder: "https://...", class: "form-input" %>
    </div>
  </fieldset>

  <div class="form-actions">
    <%= f.submit "登録する", class: "btn-submit" %>
    <%= link_to "キャンセル", dashboard_path, class: "btn-cancel" %>
  </div>
<% end %>