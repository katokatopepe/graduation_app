<script>
document.addEventListener('turbo:load', initGameForm);
document.addEventListener('DOMContentLoaded', initGameForm);

// Turboがページをキャッシュする前に初期化フラグを戻す（重要）
document.addEventListener('turbo:before-cache', () => {
  window._gameFormInitialized = false;
});

function initGameForm() {
  if (window._gameFormInitialized) return;
  window._gameFormInitialized = true;

  // ==============================
  // ① 対戦相手 → スコアラベル連動（short_name使用）
  // ==============================
  const opponentSelect = document.getElementById('game_opponent_team_id');
  const opponentLabel  = document.getElementById('opponent-score-label');

  if (opponentSelect && opponentLabel) {
    const syncOpponentLabel = () => {
      const selected = opponentSelect.options[opponentSelect.selectedIndex];
      opponentLabel.textContent = (selected && selected.value)
        ? (selected.dataset.shortName || selected.text)
        : '相手';
    };

    opponentSelect.addEventListener('change', syncOpponentLabel);
    syncOpponentLabel();
  }

  // ==============================
  // ② 写真プレビュー・削除管理
  // ==============================
  const photoPicker  = document.getElementById('photo-picker');
  const previewGrid  = document.getElementById('photo-preview-grid');
  const hiddenInputs = document.getElementById('photo-hidden-inputs');
  const uploadHint   = document.getElementById('photo-upload-hint');

  // 要素がある時だけ動かす（nullガード必須）
  if (photoPicker && previewGrid && hiddenInputs) {
    let selectedFiles = [];

    function renderPreviews() {
      previewGrid.innerHTML = '';
      hiddenInputs.innerHTML = '';

      if (uploadHint) {
        uploadHint.textContent = selectedFiles.length > 0
          ? selectedFiles.length + '枚の写真を選択中（クリックで追加）'
          : 'クリックまたはドラッグして画像を選択';
      }

      selectedFiles.forEach((file, index) => {
        const item = document.createElement('div');
        item.className = 'photo-preview-item';

        const imgWrap = document.createElement('div');
        imgWrap.className = 'photo-preview-img-wrap';

        const img = document.createElement('img');
        img.className = 'photo-preview-img';
        img.alt = 'プレビュー ' + (index + 1);

        const reader = new FileReader();
        reader.onload = (e) => { img.src = e.target.result; };
        reader.readAsDataURL(file);

        const removeBtn = document.createElement('button');
        removeBtn.type = 'button';
        removeBtn.className = 'photo-remove-btn';
        removeBtn.textContent = '✕';
        removeBtn.addEventListener('click', () => {
          selectedFiles.splice(index, 1);
          renderPreviews();
        });

        imgWrap.appendChild(img);
        imgWrap.appendChild(removeBtn);

        const name = document.createElement('span');
        name.className = 'photo-preview-name';
        name.textContent = file.name;

        item.appendChild(imgWrap);
        item.appendChild(name);
        previewGrid.appendChild(item);

        const dt = new DataTransfer();
        dt.items.add(file);

        const hiddenFile = document.createElement('input');
        hiddenFile.type = 'file';
        hiddenFile.name = 'game[photos][]';
        hiddenFile.files = dt.files;
        hiddenFile.style.display = 'none';
        hiddenInputs.appendChild(hiddenFile);
      });
    }

    photoPicker.addEventListener('change', () => {
      const newFiles = Array.from(photoPicker.files);
      selectedFiles = selectedFiles.concat(newFiles);
      photoPicker.value = '';
      renderPreviews();
    });
  }

  // ==============================
  // ③ 球場「その他」表示切替
  // ==============================
  const stadiumSelect = document.getElementById('game_stadium_id');
  const customField   = document.getElementById('custom_stadium_field');

  if (stadiumSelect && customField) {
    function toggleCustomStadium() {
      const selectedText = stadiumSelect.options[stadiumSelect.selectedIndex]?.text || '';
      customField.style.display = selectedText.includes('その他') ? 'block' : 'none';
    }
    toggleCustomStadium();
    stadiumSelect.addEventListener('change', toggleCustomStadium);
  }

  // ==============================
  // ④ 保存済み写真の削除トグル
  // ==============================
  document.querySelectorAll('.saved-photo-remove-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var id = btn.getAttribute('data-attachment-id');
      var item = document.getElementById('saved-photo-' + id);
      var container = document.getElementById('remove-photo-inputs');
      if (!item || !container) return;

      var existing = container.querySelector('input[data-remove-id="' + id + '"]');

      if (existing) {
        existing.remove();
        item.style.opacity = '1';
        btn.style.background = 'rgba(0,0,0,0.7)';
        btn.style.color = '#ff9a76';
      } else {
        var hidden = document.createElement('input');
        hidden.type = 'hidden';
        hidden.name = 'game[remove_photo_ids][]';
        hidden.value = id;
        hidden.setAttribute('data-remove-id', id);
        container.appendChild(hidden);
        item.style.opacity = '0.3';
        btn.style.background = 'rgba(255,69,0,0.7)';
        btn.style.color = '#fff';
      }
    });
  });
}

function togglePhotoRemove(btn) {
  var id = btn.getAttribute('data-attachment-id');
  var item = document.getElementById('saved-photo-' + id);
  var container = document.getElementById('remove-photo-inputs');
  var existing = document.querySelector('input[data-remove-id="' + id + '"]');

  if (existing) {
    existing.remove();
    item.style.opacity = '1';
    btn.style.background = 'rgba(0,0,0,0.7)';
    btn.style.color = '#ff9a76';
  } else {
    var hidden = document.createElement('input');
    hidden.type = 'hidden';
    hidden.name = 'game[remove_photo_ids][]';
    hidden.value = id;
    hidden.setAttribute('data-remove-id', id);
    container.appendChild(hidden);
    item.style.opacity = '0.3';
    btn.style.background = 'rgba(255,69,0,0.7)';
    btn.style.color = '#fff';
  }
}
</script>